generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  KITCHEN
  SECRETARY
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
}

enum BookingStatus {
  BOOKED
  CANCELLED
  SERVED
  NO_SHOW
}

enum ComplaintStatus {
  OPEN
  ACKNOWLEDGED
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  password     String
  role         Role            @default(STUDENT)
  createdAt    DateTime        @default(now())
  bookings     Booking[]
  complaints   Complaint[]
  reviews      Review[]
  absences     AbsenceRebate[] @relation("RebateStudent")
  decisions    AbsenceRebate[] @relation("RebateApprover")
  credits      RebateLedger[]
  rebateAudits RebateAudit[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String
  ingredients String
  included    Boolean     @default(false)
  priceRupees Int?
  photoUrl    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  offerings   Offering[]
  complaints  Complaint[]
  reviews     Review[]
}

model Service {
  id          String      @id @default(cuid())
  meal        Meal
  serviceDate DateTime    @db.Date
  cutoffAt    DateTime
  published   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  offerings   Offering[]
  complaints  Complaint[]

  @@unique([meal, serviceDate])
}

model Offering {
  id            String    @id @default(cuid())
  serviceId     String
  menuItemId    String
  quantityTotal Int
  quantityLeft  Int
  service       Service   @relation(fields: [serviceId], references: [id])
  menuItem      MenuItem  @relation(fields: [menuItemId], references: [id])
  bookings      Booking[]

  @@unique([serviceId, menuItemId])
}

model Booking {
  id            String         @id @default(cuid())
  userId        String
  offeringId    String
  count         Int            @default(1)
  status        BookingStatus  @default(BOOKED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  offering      Offering       @relation(fields: [offeringId], references: [id])
  rebateLedgers RebateLedger[]
}

model Complaint {
  id         String          @id @default(cuid())
  userId     String
  menuItemId String
  serviceId  String
  body       String
  photoUrl   String?
  status     ComplaintStatus @default(OPEN)
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id])
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  service    Service         @relation(fields: [serviceId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  menuItemId String
  stars      Int
  body       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
}

enum RebateStatus {
  PENDING
  APPROVED
  SETTLED
  REJECTED
}

model RebatePolicy {
  id             String   @id @default("single-mess")
  version        Int      @default(1)
  minimumDays    Int      @default(2)
  noticeHours    Int      @default(24)
  breakfastPaise Int      @default(0)
  lunchPaise     Int      @default(0)
  dinnerPaise    Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model AbsenceRebate {
  id             String        @id @default(cuid())
  studentId      String
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  qualifyingDays Int
  estimatedPaise Int
  policySnapshot Json
  status         RebateStatus  @default(PENDING)
  reason         String
  decisionReason String?
  approvedById   String?
  createdAt      DateTime      @default(now())
  decidedAt      DateTime?
  student        User          @relation("RebateStudent", fields: [studentId], references: [id])
  approvedBy     User?         @relation("RebateApprover", fields: [approvedById], references: [id])
  ledger         RebateLedger?
  audits         RebateAudit[]

  @@index([studentId, startDate, endDate])
  @@index([status, createdAt])
}

model RebateLedger {
  id          String        @id @default(cuid())
  rebateId    String        @unique
  studentId   String
  amountPaise Int
  details     Json
  auditHash   String
  createdAt   DateTime      @default(now())
  rebate      AbsenceRebate @relation(fields: [rebateId], references: [id])
  student     User          @relation(fields: [studentId], references: [id])
  bookings    Booking[]

  @@index([createdAt, studentId])
}

model RebateAudit {
  id           String        @id @default(cuid())
  rebateId     String
  actorId      String
  action       String
  sequence     Int
  details      Json
  previousHash String?
  auditHash    String        @unique
  createdAt    DateTime      @default(now())
  rebate       AbsenceRebate @relation(fields: [rebateId], references: [id])
  actor        User          @relation(fields: [actorId], references: [id])

  @@unique([rebateId, sequence])
}
